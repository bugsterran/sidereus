{
 "v": 1,
 "note": "A stage agent's own git commit (agent_id set) stamps cm on the stage and leaves the run open; the main agent's commit stamps cm and closes it.",
 "pipe": {
  "name": "demo-flow",
  "stages": [
   {
    "title": "설계",
    "agent": "sidereus-designer"
   },
   {
    "title": "구현",
    "agent": "sidereus-implementer",
    "fanout": "slices",
    "gate": "scripts/check.sh --fast",
    "onError": "continue"
   },
   {
    "title": "검증",
    "agent": "sidereus-verifier",
    "model": "sonnet",
    "gate": "scripts/check.sh --full",
    "onFail": {
     "goto": "구현",
     "max": 2
    }
   },
   {
    "title": "리뷰",
    "agent": "sidereus-reviewer",
    "onFail": {
     "goto": "구현",
     "max": 1,
     "then": "재검증"
    }
   },
   {
    "title": "재검증",
    "agent": "sidereus-verifier",
    "model": "sonnet",
    "onlyOnJump": true,
    "onFail": {
     "goto": "구현",
     "max": 1
    }
   },
   {
    "title": "라이브 검증",
    "agent": "general-purpose"
   }
  ]
 },
