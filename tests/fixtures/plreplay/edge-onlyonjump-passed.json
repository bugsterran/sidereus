    }
   },
   {
    "title": "재검증",
    "agent": "sidereus-verifier",
    "model": "sonnet",
    "onlyOnJump": true,
    "onFail": {
     "goto": "구현",
     "max": 1
    }
   },
   {
    "title": "라이브 검증",
    "agent": "general-purpose"
   }
  ]
 },
